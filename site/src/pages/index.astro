---
import PermitNotice from '../components/PermitNotice.astro';
import SiteList from '../components/SiteList.astro';
import SiteMap from '../components/SiteMap.astro';
import Base from '../layouts/Base.astro';
import { asset } from '../lib/paths';
import { loadSites, toMapSite } from '../lib/sites';

const all = await loadSites();
const mapSites = all.map(toMapSite);
const GROUPS = ['Luzon', 'Visayas', 'Mindanao'] as const;
const groups = GROUPS.map((g) => ({ name: g, sites: all.filter(({ site }) => site.data.islandGroup === g) }))
  .filter((g) => g.sites.length);
const sierraMadre = all.filter(({ site }) => site.data.mountainRange === 'Sierra Madre').length;
---

<Base
  title="Bantay Mina"
  description="Before-and-after satellite images of mining sites across the Philippines, with the forest loss behind them."
>
  <div class="wrap">
    <header class="head">
      <p class="label">Philippines · satellite record</p>
      <h1>What mining has done to the land, seen from orbit.</h1>
      <p class="lede">
        Free Landsat and Sentinel-2 imagery of the same place, same months, years apart. Every image is a
        cloud-free composite made the same way on both sides, and every number links back to public data.
      </p>
    </header>

    <div class="heads-up"><PermitNotice /></div>

    <SiteMap sites={mapSites} />

    <p class="range-link">
      <a href={asset('/sierra-madre/')}>Sierra Madre</a>: {sierraMadre} sites along the range, the protected
      areas around them, and what the law actually protects.
    </p>

    {groups.map((g) => <SiteList title={g.name} sites={g.sites} />)}
  </div>
</Base>

<style>
  .head {
    padding: 2.4rem 0 1.6rem;
    max-width: 44rem;
  }
  .head .label {
    margin-bottom: 0.7rem;
  }
  .heads-up {
    margin-bottom: 1rem;
  }
  .lede {
    font-size: 1.08rem;
    margin-top: 0.9rem;
    color: var(--muted);
  }
  .range-link {
    margin-top: 1rem;
    color: var(--muted);
  }
  .range-link a {
    font-weight: 600;
  }
</style>
