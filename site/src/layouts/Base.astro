---
import '../styles/global.css';
import { asset, REPO } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const fullTitle = title === 'Bantay Mina' ? title : `${title} · Bantay Mina`;
const ogImage = image ? new URL(asset(image), Astro.site ?? Astro.url).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href={asset('/')}>Bantay Mina</a>
        <nav class="label">
          <a href={asset('/')}>Sites</a>
          <a href={asset('/sierra-madre/')}>Sierra Madre</a>
          <a href={asset('/methods/')}>Methods</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap">
        <p class="muted">
          Satellite imagery: Landsat (USGS/NASA) and Copernicus Sentinel-2 (ESA), via Microsoft Planetary
          Computer. Tree cover loss: Hansen/UMD/Google/USGS/NASA. Mine footprints: Tang &amp; Werner 2023.
          Basemap © OpenStreetMap contributors, OpenFreeMap.
        </p>
        <p class="muted">
          Found an error? Every figure on this site is reproducible from the{' '}
          <a href={REPO}>published pipeline</a>. See the{' '}
          <a href={asset('/methods/#corrections')}>corrections policy</a>, or{' '}
          <a href={`${REPO}/issues`}>open an issue</a>.
        </p>
        <p class="contact">
          <a href="mailto:lacapxyniljhed@gmail.com">lacapxyniljhed@gmail.com</a>
          <span aria-hidden="true">·</span>
          <a href="https://www.linkedin.com/in/xy-lacap-76ba9029a/">LinkedIn</a>
          <span aria-hidden="true">·</span>
          <a href="https://github.com/mr-jones123">GitHub</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .top {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-top: 0.8rem;
    padding-bottom: 0.8rem;
  }
  .brand {
    font-weight: 650;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  nav {
    display: flex;
    gap: 1.25rem;
  }
  nav a {
    text-decoration: none;
  }
  main {
    padding-bottom: 3rem;
  }
  .foot {
    border-top: 1px solid var(--line);
    padding: 1.5rem 0 2.5rem;
    font-size: 0.85rem;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
  }
</style>
